{
  "name": "growthos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "drizzle-kit migrate --config=drizzle.config.test.ts",
    "db:studio": "drizzle-kit studio",
    "trigger:dev": "npx trigger.dev@latest dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@atproto/api": "^0.20.41",
    "@auth/drizzle-adapter": "^1.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "@trigger.dev/sdk": "4.5.16",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.2",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}