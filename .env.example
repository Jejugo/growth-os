# --- Banco -------------------------------------------------------------
# Neon, ou o Postgres do docker-compose (pnpm db:up):
#   postgresql://postgres:postgres@localhost:55432/growthos
DATABASE_URL=

# Porta que o compose expõe. 55432 evita colidir com um Postgres já
# instalado na máquina. Se mudar, ajuste a DATABASE_URL junto.
POSTGRES_PORT=55432

# --- Auth --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Allowlist de e-mails, separada por vírgula. Ninguém fora dela entra.
AUTH_ALLOWED_EMAILS=voce@exemplo.com

# --- IA ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Guardas de custo (Fase 0) -----------------------------------------
# Teto mensal de gasto com LLM por produto, em USD. Excedido = job aborta.
AI_MONTHLY_BUDGET_USD_PER_PRODUCT=25

# --- Crawler -----------------------------------------------------------
CRAWLER_USER_AGENT=GrowthOSBot/0.1 (+https://github.com/seu-usuario/growthos)

# --- Opcionais ---------------------------------------------------------
TRIGGER_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
