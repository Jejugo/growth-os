# --- Banco -------------------------------------------------------------
# Neon, ou o Postgres do docker-compose (pnpm db:up):
#   postgresql://postgres:postgres@localhost:55432/growthos
DATABASE_URL=

# Porta que o compose expõe. 55432 evita colidir com um Postgres já
# instalado na máquina. Se mudar, ajuste a DATABASE_URL junto.
POSTGRES_PORT=55432

# Banco SEPARADO só para os testes de integração que precisam de Postgres real
# (tests/integration/*.test.ts) — eles fazem DELETE em massa nas tabelas.
# NUNCA aponte isto para o mesmo banco de DATABASE_URL: src/lib/db/index.ts
# recusa rodar se as duas URLs forem iguais, exatamente para evitar apagar
# dado de desenvolvimento por engano.
#   docker exec growthos-pg psql -U postgres -c "CREATE DATABASE growthos_test;"
#   pnpm db:migrate:test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/growthos_test

# --- Auth --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# GitHub → Settings → Developer settings → OAuth Apps
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Allowlist de e-mails, separada por vírgula. Ninguém fora dela entra.
AUTH_ALLOWED_EMAILS=voce@exemplo.com

# --- IA ----------------------------------------------------------------
# Configure UMA das duas chaves abaixo. Anthropic tem prioridade se ambas estiverem presentes.
# Anthropic: claude-haiku-4-5 / claude-sonnet-5 / claude-opus-5
ANTHROPIC_API_KEY=
# OpenAI: gpt-4o-mini / gpt-4o
OPENAI_API_KEY=

# --- Guardas de custo (Fase 0) -----------------------------------------
# Teto mensal de gasto com LLM por produto, em USD. Excedido = job aborta.
AI_MONTHLY_BUDGET_USD_PER_PRODUCT=25

# --- Crawler -----------------------------------------------------------
CRAWLER_USER_AGENT=GrowthOSBot/0.1 (+https://github.com/seu-usuario/growthos)

# --- Landing pages automáticas (fase 4.5) -------------------------------
# Token pessoal: vercel.com/account/tokens
VERCEL_API_TOKEN=
# Só necessário se o token acima pertencer a uma conta de time.
VERCEL_TEAM_ID=
# Host público deste app — a landing publicada chama esse host de volta pra
# registrar inscrições na waitlist. Em produção, aponte pro domínio real.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Opcionais ---------------------------------------------------------
TRIGGER_SECRET_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
